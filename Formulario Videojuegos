  <!-- Formulario -->
<div class="container mt-5">
  <h2 class="text-center mb-4">Formulario de Compra</h2>
  <form class="was-validated" novalidate>
    <!-- Nombre -->
    <div class="mb-3">
      <label for="nombre" class="form-label">Nombre completo</label>
      <input type="text" class="form-control" id="nombre" required>
      <div class="valid-feedback">¡Este campo es obligatorio!</div>
      <div class="invalid-feedback">Ingresa tu nombre.</div>
    </div>

      <!-- Correo -->
      <div class="mb-3">
        <label for="email" class="form-label">Correo electrónico</label>
        <input type="email" class="form-control" id="email" required>
       <div class="valid-feedback">¡Este campo es obligatorio!</div>
      <div class="invalid-feedback">Ingresa un correo válido.</div>
    </div>

      <!-- Videojuego -->
      <div class="mb-3">
        <label for="juego" class="form-label">Selecciona el videojuego</label>
        <select class="form-select" id="juego" required>
          <option value="">Elige uno...</option>
          <option>EA Sports FC 26</option>
          <option>Grand Theft Auto V (GTA V)</option>
          <option>Red Dead Redemption 2</option>
          <option>Watch Dogs 2</option>
          <option>Call of Duty: Black Ops 7</option>
          <option>Forza Horizon 5</option>
          <option>WWE 2K25</option>
          <option>Riders Republic</option>
          <option>EA Sports College Football 26</option>
          <option>The Last of Us Parte II Remastered</option>
          <option>God of War: Ragnarök</option>
          <option>Horizon Forbidden West</option>
          <option>Marvel's Spider-Man</option>
          <option>Spider-Man 2</option>
          <option>Spider-Man: Miles Morales</option>
          <option>Mortal Kombat 1</option>
          <option>Gran Turismo 7</option>
          <option>Ghost of Tsushima: Director's Cut</option>
          <option>Dragon Ball Sparking! ZERO</option>
          <option>Street Fighter 6</option>
          <option>Uncharted: Legacy of Thieves</option>
          <option>Resident Evil 4 Remake</option>
          <option>Schedule I</option>
          <option>MLB The Show 25</option>
          <option>Jujutsu Kaisen: Cursed Clash</option>
          <option>Dead Island 2: Ultimate Edition</option>
          <option>Cuphead</option>
          <option>Fortnite</option>
          <option>Marvel vs Capcom: Infinite</option>
          <option>Destiny 2: The Final Shape</option>
          <option>Grounded</option>
          <option>Fall Guys</option>
          <option>Minecraft</option>
          <option>Rocket League</option>
          <option>Hollow Knight</option>
          <option>NBA 2K26</option>
          <option>Naruto a Boruto: Shinobi Striker</option>
          <option>Fallout 4</option>
          <option>Cyberpunk 2077</option>
          <option>Contraataque 2</option>
          <option>Grito lejano</option>
          <option>Halo Infinito</option>
          <option>Necesidad de calor rápido</option>
          <option>Necesidad de velocidad desatada</option>
          <option>Poppy Playtime: Capítulo 3</option>
          <option>Poppy Playtime: Capítulo 4</option>
          <option>Astro Bot</option>
          <option>Revancha</option>
        </select>
        <div class="invalid-feedback">Selecciona un videojuego.</div>
      </div>

      <!-- Método de pago -->
      <div class="mb-3">
        <label for="pago" class="form-label">Método de pago</label>
        <select class="form-select" id="pago" required>
          <option value="">Selecciona uno...</option>
          <option value="tarjeta">Tarjeta de crédito</option>
          <option value="efectivo">Pago en efectivo</option>
        </select>
        <div class="invalid-feedback">Selecciona un método de pago.</div>
      </div>


      <!-- Botón de envío -->
      div class="text-center">
        <button class="btn btn-danger" type="button" data-bs-toggle="modal" data-bs-target="#modalCompra">
  Enviar
</button>
    
